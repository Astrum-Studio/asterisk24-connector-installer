# Asterisk Connector — copy to .env (or run ./scripts/init-env.sh / ./install.sh)
# Secrets below are placeholders; init-env.sh generates strong values.

APP_NAME=Asterisk Connector
ENV=production
DEBUG=false

# Public URL of this connector (TLS-terminated proxy recommended in production).
BASE_URL=http://localhost:8079
# Host port published by docker compose (container listens on 8077)
EXPOSED_APP_PORT=8079
# Publish only on loopback by default (F6). Use 0.0.0.0 only behind a local TLS proxy.
BIND_HOST=127.0.0.1
# Native uvicorn bind (scripts/run-app.sh). Same default as BIND_HOST.
LISTEN_HOST=127.0.0.1
# Market App base URL (S2S)
MARKET_APP_URL=https://app-11.astrum.agency

# Connector auth + at-rest encryption (Fernet). Leave empty for init-env.sh to fill.
# API key must be at least 16 characters when set manually.
CONNECTOR__API_KEY=
CONNECTOR__ENCRYPTION_KEY=
# HMAC secret for public recording URLs (optional; derived from ENCRYPTION_KEY if empty).
CONNECTOR__RECORDING_SIGNING_KEY=

# PostgreSQL
# Docker Compose: hostname is "db". Native install: use 127.0.0.1 (init-env --native).
DB__HOST=db
DB__PORT=5432
DB__USER=connector
DB__PASSWORD=
DB__NAME=connector

# GHCR image tag — required for docker compose (no :latest fallback).
CONNECTOR_VERSION=1.0.0
# Deprecated alias (init-env keeps in sync).
CONNECTOR_IMAGE_TAG=1.0.0

# Asterisk recordings (mounted read-only into containers)
RECORDINGS_DIR=/var/spool/asterisk/monitor
RECORDINGS_PATH=/var/spool/asterisk/monitor

# CEL eventtime timezone (Asterisk writes local time by default).
# IANA name (e.g. Europe/Moscow) or "local" / "UTC".
ASTERISK_TIMEZONE=local
