[Unit]
Description=Astrum Bitrix24 Asterisk Connector (API)
Documentation=https://github.com/Astrum-Studio/asterisk24-connector-installer
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=connector
Group=connector
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
Environment=ENV_FILE=__INSTALL_DIR__/.env
Environment=CONNECTOR_HOME=__INSTALL_DIR__
Environment=PATH=__INSTALL_DIR__/:/usr/local/bin:/usr/bin
Environment=LISTEN_PORT=__LISTEN_PORT__
ExecStart=__INSTALL_DIR__/connector serve --host 127.0.0.1 --port __LISTEN_PORT__
Restart=always
RestartSec=5
TimeoutStartSec=120
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=connector-app
UMask=0077
# Hardening: code is root-owned and read-only for the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=__PROTECT_HOME__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
StateDirectory=connector
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
